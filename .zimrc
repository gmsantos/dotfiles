#
# This is not sourced during shell startup and is only used to configure zimfw.
#

#
# Modules
#

# Sets sane Zsh built-in environment options.
zmodule environment
# Applies correct bindkeys for input events.
zmodule input
# Sets a custom terminal title.
zmodule termtitle
# Utility aliases and functions. Adds colour to ls, grep and less.
zmodule utility

# <-- Normally new modules should be added here. Check each module documentation
# for any caveats.

# Matches the autosuggestion colour and the prompt palette to the Windows apps
# theme. Only present under WSL, where reg.exe is on the path. Must come before
# the prompt, which registers itself with this module to be repainted.
zmodule ${ZDOTDIR:-${HOME}}/.zsh/modules/wsl-theme --if-command reg.exe

#
# Prompt
#

# Exposes how long the last command took to run to prompts.
zmodule duration-info
# Exposes git repository status information to prompts.
zmodule git-info
zmodule prompt-pwd

# Feeds the current kube context and namespace to the prompt. Replaces the
# oh-my-zsh kube-ps1 plugin, which shelled out to kubectl twice (~600ms) on
# every kubeconfig change and forked half a dozen subshells per prompt to
# colour its output. Must come before the prompt, which registers a callback
# with it.
zmodule ${ZDOTDIR:-${HOME}}/.zsh/modules/kubecontext

# Three-line prompt: blank line, then path + git + kube context, then `>`.
# Recolours itself for the light and dark Windows themes.
zmodule ${ZDOTDIR:-${HOME}}/.zsh/modules/prompt-adaptive

#
# Completion
#

# Additional completion definitions for Zsh.
zmodule zsh-users/zsh-completions --fpath src
# Enables and configures smart and extensive tab completion, must be sourced
# after all modules that add completion definitions.
zmodule completion

# oh-my-zsh git and kubectl aliases. Both roots share a single checkout of the
# ohmyzsh repo. These replace zim's own `git` module, whose aliases collide with
# the oh-my-zsh names while meaning different things (`gl`, `gd`, `gcm`, ...).
# Both plugins call `compdef`, and the kubectl one declares `_comps`, so they
# have to be sourced after the completion module runs compinit. The git plugin
# also calls `is-at-least` while sourcing, so autoload that first.
zmodule ohmyzsh/ohmyzsh --root plugins/git --use git --no-submodules --if-command git \
    --cmd 'autoload -Uz is-at-least' --source git.plugin.zsh
zmodule ohmyzsh/ohmyzsh --root plugins/kubectl --use git --no-submodules --if-command kubectl \
    --source kubectl.plugin.zsh

# `ktx` and `kns`, to switch context and namespace. Reads the kubeconfig through
# the kubecontext module above, so it has to come after it, and calls compdef,
# so it has to come after the completion module.
zmodule ${ZDOTDIR:-${HOME}}/.zsh/modules/kubeswitch --if-command kubectl

#
# Modules that must be initialized last
#

# Fish-like syntax highlighting for Zsh, must be sourced after completion.
zmodule zsh-users/zsh-syntax-highlighting
# Fish-like history search for Zsh, must be sourced after
# zsh-users/zsh-syntax-highlighting.
zmodule zsh-users/zsh-history-substring-search
# Fish-like autosuggestions for Zsh. Add the following to your ~/.zshrc to boost
# performance: ZSH_AUTOSUGGEST_MANUAL_REBIND=1
zmodule zsh-users/zsh-autosuggestions
